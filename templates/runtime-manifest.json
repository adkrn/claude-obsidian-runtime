{
  "runtimeVersion": "3.0.0",
  "projectTag": "{{PROJECT_ID}}",
  "defaultScope": "repo",
  "coreHooks": "all",
  "useRuntimeHome": true,
  "legacyScriptsRelativePath": null,
  "surfacePatterns": [],
  "scopeFolderMap": {},
  "preserveHooks": [],
  "sessionEndPipeline": ["all"],
  "projectKinds": [],
  "agentFanoutCap": 2,
  "reflection": {
    "interval": "monthly",
    "enabled": false
  },
  "forgetting": {
    "maxIdleDays": 180,
    "minImportance": 5
  },
  "promotion": {
    "confidenceThreshold": 0.75,
    "reuseCount": 2
  },
  "governance": {
    "enabled": false,
    "retentionDays": 180,
    "maxReasonLength": 100,
    "loopDetection": {
      "window_minutes": 5,
      "threshold": 3
    },
    "rotation": {
      "strategy": "monthly",
      "maxFileBytes": 104857600
    }
  }
}
